{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "StockReplenishment",
    "SeedDemoData": true
  },
  "StockCheck": {
    "MaxConcurrentChecks": 4,
    "MaxAttempts": 3,
    "AttemptTimeout": "00:00:20",
    "RetryBaseDelay": "00:00:02"
  },
  "SimulatedStockService": {
    "MinLatency": "00:00:03",
    "MaxLatency": "00:00:08",
    "FailureRate": 0.15
  }
}
