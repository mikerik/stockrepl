<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>StockReplenishment.Api</RootNamespace>
    <!-- Lets the OpenAPI generator use the /// comments as endpoint descriptions in Swagger UI.
         CS1591 (missing comment) is silenced: not every public member needs documentation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockReplenishment.Contracts\StockReplenishment.Contracts.csproj" />
    <ProjectReference Include="..\StockReplenishment.Client\StockReplenishment.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StockReplenishment.Api.Tests" />
  </ItemGroup>

</Project>
